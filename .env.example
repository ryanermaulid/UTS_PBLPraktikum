APP_ENV=development
PORT=3000

# Wajib. Contoh: postgres://user:password@localhost:5432/siakad?sslmode=disable
DATABASE_URL=

# Wajib, minimal 32 karakter. Contoh 32+ karakter acak:
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
JWT_EXPIRES_MINUTES=60

LOG_LEVEL=info
LOG_FILE=logs/app.log
